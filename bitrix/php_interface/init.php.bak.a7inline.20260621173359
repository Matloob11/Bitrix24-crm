<?php
// A7_INLINE_CRM_AUDIO_PLAYER
// Shows CRM timeline audio attachments as inline voice-note players.
if (!function_exists('a7_inline_crm_audio_player')) {
    AddEventHandler('main', 'OnEndBufferContent', 'a7_inline_crm_audio_player');

    function a7_inline_crm_audio_player(&$content)
    {
        if (defined('ADMIN_SECTION') && ADMIN_SECTION === true) {
            return;
        }

        $uri = isset($_SERVER['REQUEST_URI']) ? $_SERVER['REQUEST_URI'] : '';
        if (!preg_match('#^/crm/(lead|deal|contact|company)/details/[0-9]+/#', $uri)) {
            return;
        }

        if (strpos($content, 'A7_INLINE_CRM_AUDIO_PLAYER_JS') !== false) {
            return;
        }

        $asset = <<<'HTML'
<style id="A7_INLINE_CRM_AUDIO_PLAYER_JS">
.a7-voice-note{display:flex;align-items:center;gap:10px;width:300px;max-width:100%;box-sizing:border-box;margin:4px 0 2px;padding:7px 10px;border:1px solid #dfe7ef;border-radius:22px;background:#fff;box-shadow:0 1px 2px rgba(15,43,71,.06);font-family:Arial,sans-serif}.a7-voice-play{position:relative;flex:0 0 32px;width:32px;height:32px;border:0;border-radius:50%;background:#27a9e8;cursor:pointer;outline:none}.a7-voice-play:before{content:"";position:absolute;left:13px;top:10px;width:0;height:0;border-top:6px solid transparent;border-bottom:6px solid transparent;border-left:9px solid #fff}.a7-voice-note.is-playing .a7-voice-play:before{left:10px;top:9px;width:4px;height:14px;border:0;background:#fff;box-shadow:8px 0 0 #fff}.a7-voice-wave{position:relative;flex:1;min-width:90px;height:26px;cursor:pointer;overflow:hidden;background:repeating-linear-gradient(90deg,rgba(39,169,232,.28) 0 2px,transparent 2px 7px)}.a7-voice-wave:after{content:"";position:absolute;left:0;top:0;height:100%;width:var(--a7-progress,0%);background:repeating-linear-gradient(90deg,#27a9e8 0 2px,transparent 2px 7px)}.a7-voice-time{flex:0 0 auto;min-width:42px;text-align:right;color:#4b5b68;font-size:12px;line-height:1}.a7-voice-audio{display:none!important}.a7-audio-hidden{display:none!important}
</style>
<script id="A7_INLINE_CRM_AUDIO_PLAYER_SCRIPT">
(function(){
  if (window.A7InlineCrmAudioPlayer) { return; }
  window.A7InlineCrmAudioPlayer = true;
  var audioNamePattern = /.(mp3|m4a|ogg|wav)(s|$|?)/i;

  function formatTime(seconds) {
    if (!isFinite(seconds) || seconds < 0) { return '0:00'; }
    seconds = Math.floor(seconds);
    var minutes = Math.floor(seconds / 60);
    var rest = seconds % 60;
    return minutes + ':' + (rest < 10 ? '0' : '') + rest;
  }

  function hideNativeFileRow(anchor) {
    var fileWrap = anchor.closest ? anchor.closest('.feed-com-file-wrap') : null;
    if (fileWrap) { fileWrap.classList.add('a7-audio-hidden'); }
    var filesBlock = anchor.closest ? anchor.closest('.feed-com-files') : null;
    if (filesBlock) {
      var title = filesBlock.querySelector('.feed-com-files-title');
      if (title) { title.classList.add('a7-audio-hidden'); }
    }
    return fileWrap;
  }

  function stopOtherPlayers(currentAudio) {
    var players = document.querySelectorAll('.a7-voice-audio');
    Array.prototype.forEach.call(players, function(player) {
      if (player !== currentAudio) { player.pause(); }
    });
  }

  function enhanceLink(anchor) {
    if (!anchor || anchor.getAttribute('data-a7-inline-audio') === '1') { return; }
    var label = ((anchor.getAttribute('title') || '') + ' ' + (anchor.textContent || '')).toLowerCase();
    if (!audioNamePattern.test(label)) { return; }
    var href = anchor.href || anchor.getAttribute('href');
    if (!href) { return; }

    anchor.setAttribute('data-a7-inline-audio', '1');
    var fileWrap = hideNativeFileRow(anchor);
    var insertAfter = fileWrap || anchor;
    var parent = insertAfter.parentNode;
    if (!parent) { return; }

    var note = document.createElement('div');
    note.className = 'a7-voice-note';

    var button = document.createElement('button');
    button.type = 'button';
    button.className = 'a7-voice-play';
    button.setAttribute('aria-label', 'Play recording');

    var wave = document.createElement('div');
    wave.className = 'a7-voice-wave';

    var time = document.createElement('span');
    time.className = 'a7-voice-time';
    time.textContent = '0:00';

    var audio = document.createElement('audio');
    audio.className = 'a7-voice-audio';
    audio.preload = 'metadata';
    audio.src = href;

    note.appendChild(button);
    note.appendChild(wave);
    note.appendChild(time);
    note.appendChild(audio);
    parent.insertBefore(note, insertAfter.nextSibling);

    function update() {
      var duration = audio.duration || 0;
      var current = audio.currentTime || 0;
      var remaining = duration ? Math.max(0, duration - current) : 0;
      time.textContent = duration ? '-' + formatTime(remaining) : '0:00';
      var progress = duration ? Math.max(0, Math.min(100, (current / duration) * 100)) : 0;
      wave.style.setProperty('--a7-progress', progress + '%');
    }

    button.addEventListener('click', function() {
      if (audio.paused) {
        stopOtherPlayers(audio);
        audio.play().catch(function(){});
      } else {
        audio.pause();
      }
    });

    wave.addEventListener('click', function(event) {
      if (!audio.duration) { return; }
      var rect = wave.getBoundingClientRect();
      audio.currentTime = ((event.clientX - rect.left) / rect.width) * audio.duration;
      update();
    });

    audio.addEventListener('loadedmetadata', update);
    audio.addEventListener('timeupdate', update);
    audio.addEventListener('play', function(){ note.classList.add('is-playing'); });
    audio.addEventListener('pause', function(){ note.classList.remove('is-playing'); });
    audio.addEventListener('ended', function(){ note.classList.remove('is-playing'); update(); });
  }

  function enhance() {
    var links = document.querySelectorAll('a.feed-com-file-name');
    Array.prototype.forEach.call(links, enhanceLink);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', enhance);
  } else {
    enhance();
  }
  var observer = new MutationObserver(enhance);
  observer.observe(document.documentElement, {childList:true, subtree:true});
  setInterval(enhance, 2000);
})();
</script>
HTML;

        if (stripos($content, '</body>') !== false) {
            $content = preg_replace('#</body>#i', $asset . '</body>', $content, 1);
        } else {
            $content .= $asset;
        }
    }
}
