function a7_int_between(int $value, int $min, int $max): int
{
    if ($value < $min) {
        return $min;
    }
    if ($value > $max) {
        return $max;
    }
    return $value;
}

function a7_recording_lock_acquire()
{
    $handle = @fopen(A7_RECORDING_LOCK_FILE, 'c');
    if (!$handle) {
        return null;
    }

    if (!@flock($handle, LOCK_EX | LOCK_NB)) {
        @fclose($handle);
        return null;
    }

    @ftruncate($handle, 0);
    @fwrite($handle, json_encode(['pid' => getmypid(), 'time' => date('c')]));
    return $handle;
}

function a7_recording_lock_release($handle): void
{
    if (is_resource($handle)) {
        @flock($handle, LOCK_UN);
        @fclose($handle);
    }
}

function a7_recording_rate_prepare(array &$config): void
{
    $hour = date('Y-m-d-H');
    $day = date('Y-m-d');
    if (($config['recording_rate_hour'] ?? '') !== $hour) {
        $config['recording_rate_hour'] = $hour;
        $config['recording_rate_hour_writes'] = 0;
    }
    if (($config['recording_rate_day'] ?? '') !== $day) {
        $config['recording_rate_day'] = $day;
        $config['recording_rate_day_writes'] = 0;
    }
}

function a7_recording_rate_remaining(array &$config): array
{
    a7_recording_rate_prepare($config);
    $hourUsed = (int)($config['recording_rate_hour_writes'] ?? 0);
    $dayUsed = (int)($config['recording_rate_day_writes'] ?? 0);
    $hourRemaining = max(0, A7_RECORDING_MAX_WRITES_PER_HOUR - $hourUsed);
    $dayRemaining = max(0, A7_RECORDING_MAX_WRITES_PER_DAY - $dayUsed);
    return [
        'hourUsed' => $hourUsed,
        'dayUsed' => $dayUsed,
        'hourRemaining' => $hourRemaining,
        'dayRemaining' => $dayRemaining,
        'allowedNow' => min($hourRemaining, $dayRemaining),
    ];
}

function a7_recording_rate_register(array &$config, int $created): void
{
    if ($created <= 0) {
        return;
    }

    a7_recording_rate_prepare($config);
    $config['recording_rate_hour_writes'] = (int)($config['recording_rate_hour_writes'] ?? 0) + $created;
    $config['recording_rate_day_writes'] = (int)($config['recording_rate_day_writes'] ?? 0) + $created;
}

function a7_recording_min_gap(array $config): int
{
    $configured = (int)($config['recording_agent_interval'] ?? 0);
    if ($configured > 0) {
        return max(A7_RECORDING_MIN_SYNC_SECONDS, $configured - 15);
    }
    return A7_RECORDING_MIN_SYNC_SECONDS;
}

function a7_recording_age_seconds(array $recording): ?int
{
    $value = (string)($recording['EndTime'] ?? ($recording['StartTime'] ?? ''));
    if ($value === '') {
        return null;
    }

    $timestamp = strtotime($value);
    if ($timestamp === false) {
        return null;
    }

    return time() - $timestamp;
}

function a7_recording_cache_ttl(string $status, string $reason): int
{
    if ($status === 'created' || $reason === 'already_synced') {
        return 7 * 86400;
    }

    if (in_array($reason, [
        'no_matching_bitrix_lead',
        'ambiguous_or_unverified_bitrix_lead_match',
        'no_matching_bitrix_entity',
        'ambiguous_or_unverified_bitrix_entity_match',
    ], true)) {
        return 3600;
    }

    return 0;
}

function a7_recording_cached_skip(array $config, int $recordingId): ?array
{
    if ($recordingId <= 0) {
        return null;
    }

    $cache = $config['recording_processed_cache'] ?? [];
    if (!is_array($cache) || empty($cache[$recordingId]) || !is_array($cache[$recordingId])) {
        return null;
    }

    $entry = $cache[$recordingId];
    $ts = (int)($entry['ts'] ?? 0);
    $status = (string)($entry['status'] ?? '');
    $reason = (string)($entry['reason'] ?? '');
    $matchVersion = (int)($entry['matchVersion'] ?? 0);
    if ($matchVersion !== A7_RECORDING_MATCH_VERSION
        && $status !== 'created'
        && $reason !== 'already_synced'
    ) {
        return null;
    }

    $ttl = a7_recording_cache_ttl($status, $reason);
    if ($ts <= 0 || $ttl <= 0 || (time() - $ts) >= $ttl) {
        return null;
    }

    return [
        'status' => 'skipped',
        'reason' => 'cached_' . ($reason !== '' ? $reason : $status),
        'cachedAt' => date('c', $ts),
        'cacheTtlSeconds' => $ttl,
    ];
}

function a7_recording_cache_register(array &$config, int $recordingId, array $sync): void
{
    if ($recordingId <= 0) {
        return;
    }

    $status = (string)($sync['status'] ?? '');
    $reason = (string)($sync['reason'] ?? '');
    if (a7_recording_cache_ttl($status, $reason) <= 0) {
        return;
    }

    $cache = $config['recording_processed_cache'] ?? [];
    if (!is_array($cache)) {
        $cache = [];
    }

    $cache[$recordingId] = [
        'ts' => time(),
        'status' => $status,
        'reason' => $reason,
        'matchVersion' => A7_RECORDING_MATCH_VERSION,
    ];

    uasort($cache, static function ($a, $b) {
        return (int)($b['ts'] ?? 0) <=> (int)($a['ts'] ?? 0);
    });

    if (count($cache) > A7_RECORDING_PROCESSED_CACHE_LIMIT) {
        $cache = array_slice($cache, 0, A7_RECORDING_PROCESSED_CACHE_LIMIT, true);
    }

    $config['recording_processed_cache'] = $cache;
}

