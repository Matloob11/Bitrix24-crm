function a7_run_recording_sync_guarded(int $limit, bool $dryRun, int $maxWrites, int $userId, string $source = 'manual'): array
{
    $limit = a7_int_between($limit <= 0 ? 10 : $limit, 1, A7_RECORDING_MAX_LIMIT_PER_RUN);
    $maxWrites = a7_int_between($maxWrites, 0, A7_RECORDING_MAX_WRITES_PER_RUN);

    if ($dryRun) {
        return a7_run_recording_sync($limit, true, 0, $userId, $source);
    }

    if ($maxWrites <= 0) {
        return a7_recording_guarded_skip('max_writes_zero');
    }

    $lock = a7_recording_lock_acquire();
    if (!$lock) {
        return a7_recording_guarded_skip('lock_busy');
    }

    try {
        $config = a7_read_config();
        $now = time();
        $lastAttemptTs = (int)($config['recording_guard_last_attempt_ts'] ?? 0);
        $minGap = a7_recording_min_gap($config);
        if ($lastAttemptTs > 0 && ($now - $lastAttemptTs) < $minGap) {
            return a7_recording_guarded_skip('throttled', [
                'lastAttempt' => (string)($config['recording_guard_last_attempt'] ?? ''),
                'nextAllowedInSeconds' => $minGap - ($now - $lastAttemptTs),
            ]);
        }

        $rate = a7_recording_rate_remaining($config);
        if ($rate['allowedNow'] <= 0) {
            $config['recording_guard_last_attempt_ts'] = $now;
            $config['recording_guard_last_attempt'] = date('c', $now);
            a7_write_config($config);
            return a7_recording_guarded_skip('write_rate_limited', ['rate' => $rate]);
        }

        $maxWrites = min($maxWrites, (int)$rate['allowedNow']);
        $config['recording_guard_last_attempt_ts'] = $now;
        $config['recording_guard_last_attempt'] = date('c', $now);
        a7_write_config($config);

        $result = a7_run_recording_sync($limit, false, $maxWrites, $userId, $source);
        $created = (int)($result['createdCount'] ?? 0);

        $config = a7_read_config();
        a7_recording_rate_register($config, $created);
        $config['recording_guard_last_run'] = date('c');
        $config['recording_guard_last_result'] = [
            'source' => $source,
            'limit' => $limit,
            'maxWrites' => $maxWrites,
            'createdCount' => $created,
            'checkedRecordings' => (int)($result['checkedRecordings'] ?? 0),
        ];
        a7_write_config($config);

        $result['ran'] = true;
        $result['guard'] = [
            'minGapSeconds' => $minGap,
            'maxLimitPerRun' => A7_RECORDING_MAX_LIMIT_PER_RUN,
            'maxWritesPerRun' => A7_RECORDING_MAX_WRITES_PER_RUN,
            'maxWritesPerHour' => A7_RECORDING_MAX_WRITES_PER_HOUR,
            'maxWritesPerDay' => A7_RECORDING_MAX_WRITES_PER_DAY,
            'readyDelaySeconds' => A7_RECORDING_READY_DELAY_SECONDS,
            'rate' => a7_recording_rate_remaining($config),
        ];
        return $result;
    } finally {
        a7_recording_lock_release($lock);
    }
}

function a7_http_json(string $method, string $url, array $headers = [], $body = null): array
{
    $headerLines = ['Accept: application/json'];
    foreach ($headers as $name => $value) {
        $headerLines[] = $name . ': ' . $value;
    }

    $encodedBody = null;
    if ($body !== null) {
        $encodedBody = is_string($body) ? $body : json_encode($body, JSON_UNESCAPED_SLASHES);
    }

    if (!function_exists('curl_init')) {
        $contextOptions = [
            'http' => [
                'method' => strtoupper($method),
                'header' => implode("\r\n", $headerLines),
                'ignore_errors' => true,
                'timeout' => 30,
            ],
        ];

        if ($encodedBody !== null) {
            $contextOptions['http']['content'] = $encodedBody;
        }

        $context = stream_context_create($contextOptions);
        $raw = @file_get_contents($url, false, $context);
        $status = 0;

        if (isset($http_response_header) && is_array($http_response_header)) {
            foreach ($http_response_header as $line) {
                if (preg_match('/^HTTP\/\S+\s+(\d{3})\b/', (string)$line, $matches)) {
                    $status = (int)$matches[1];
                    break;
                }
            }
        }

        $error = '';
        if ($raw === false) {
            $lastError = error_get_last();
            $error = is_array($lastError) ? (string)($lastError['message'] ?? '') : 'HTTP request failed';
            $raw = '';
        }

        $json = json_decode((string) $raw, true);
        return [
            'ok' => $error === '' && $status >= 200 && $status < 300,
            'status' => $status,
            'raw' => $raw,
            'json' => is_array($json) ? $json : null,
            'error' => $error,
        ];
    }

    $curl = curl_init($url);

    curl_setopt_array($curl, [
        CURLOPT_RETURNTRANSFER => true,
        CURLOPT_CUSTOMREQUEST => strtoupper($method),
        CURLOPT_HTTPHEADER => $headerLines,
        CURLOPT_TIMEOUT => 30,
        CURLOPT_CONNECTTIMEOUT => 10,
    ]);

    if ($encodedBody !== null) {
        curl_setopt($curl, CURLOPT_POSTFIELDS, $encodedBody);
    }

    $raw = curl_exec($curl);
    $error = curl_error($curl);
    $status = (int) curl_getinfo($curl, CURLINFO_HTTP_CODE);
    curl_close($curl);

    $json = json_decode((string) $raw, true);
    return [
        'ok' => $error === '' && $status >= 200 && $status < 300,
        'status' => $status,
        'raw' => $raw,
        'json' => is_array($json) ? $json : null,
        'error' => $error,
    ];
}

