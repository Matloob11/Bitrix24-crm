function a7_handle_recording_agent_install(): void
{
    $userId = a7_require_bitrix_admin();
    if (!class_exists('CAgent')) {
        a7_json(['success' => false, 'message' => 'Bitrix CAgent class not available'], 500);
    }

    $interval = (int) a7_request_value('interval', A7_RECORDING_MIN_SYNC_SECONDS);
    if ($interval < A7_RECORDING_MIN_SYNC_SECONDS) {
        $interval = A7_RECORDING_MIN_SYNC_SECONDS;
    }
    if ($interval > 1800) {
        $interval = 1800;
    }

    $limit = (int) a7_request_value('limit', A7_RECORDING_MAX_LIMIT_PER_RUN);
    if ($limit <= 0) {
        $limit = A7_RECORDING_MAX_LIMIT_PER_RUN;
    }
    if ($limit > A7_RECORDING_MAX_LIMIT_PER_RUN) {
        $limit = A7_RECORDING_MAX_LIMIT_PER_RUN;
    }

    $maxWrites = (int) a7_request_value('maxWrites', A7_RECORDING_MAX_WRITES_PER_RUN);
    if ($maxWrites <= 0) {
        $maxWrites = 1;
    }
    if ($maxWrites > A7_RECORDING_MAX_WRITES_PER_RUN) {
        $maxWrites = A7_RECORDING_MAX_WRITES_PER_RUN;
    }

    $config = a7_read_config();
    $token = a7_recording_agent_token($config);
    $config['recording_agent_enabled'] = 'Y';
    $config['recording_agent_interval'] = $interval;
    $config['recording_agent_limit'] = $limit;
    $config['recording_agent_max_writes'] = $maxWrites;
    $config['recording_agent_user_id'] = $userId;
    a7_write_config($config);

    $oldHttpExpression = a7_recording_agent_expression($token);
    $expression = a7_recording_agent_include_expression();
    CAgent::RemoveAgent($oldHttpExpression, '');
    CAgent::RemoveAgent($expression, '');

    $nextExec = '';
    if (function_exists('ConvertTimeStamp')) {
        $nextExec = ConvertTimeStamp(time() + 60, 'FULL');
    }

    $agentId = CAgent::AddAgent($expression, '', 'N', $interval, '', 'Y', $nextExec, 100, false, false);
    if (!$agentId) {
        a7_json(['success' => false, 'message' => 'Unable to add Bitrix agent'], 500);
    }

    a7_log('recording sync agent installed', [
        'agent_id' => (int)$agentId,
        'interval' => $interval,
        'limit' => $limit,
        'max_writes' => $maxWrites,
        'user_id' => $userId,
    ]);

    a7_json([
        'success' => true,
        'message' => 'Recording auto-sync agent installed',
        'agentId' => (int)$agentId,
        'intervalSeconds' => $interval,
        'limit' => $limit,
        'maxWrites' => $maxWrites,
        'agentRows' => a7_agent_rows($expression),
    ]);
}

