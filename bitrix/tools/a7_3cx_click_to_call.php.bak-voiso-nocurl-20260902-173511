function a7_handle_recording_sync_agent_run(): void
{
    $config = a7_read_config();
    $expectedToken = (string)($config['recording_agent_token'] ?? '');
    $token = (string) a7_request_value('token', '');

    if ($expectedToken === '' || $token === '' || !hash_equals($expectedToken, $token)) {
        a7_log('recording sync agent invalid token');
        a7_text_response('', 403);
    }

    $expression = a7_recording_agent_expression($expectedToken);
    if (($config['recording_agent_enabled'] ?? 'Y') !== 'Y') {
        a7_log('recording sync agent disabled');
        a7_text_response($expression);
    }

    $limit = (int)($config['recording_agent_limit'] ?? A7_RECORDING_MAX_LIMIT_PER_RUN);
    $maxWrites = (int)($config['recording_agent_max_writes'] ?? A7_RECORDING_MAX_WRITES_PER_RUN);
    $userId = (int)($config['recording_agent_user_id'] ?? 1);
    if ($userId <= 0) {
        $userId = 1;
    }

    try {
        $result = a7_run_recording_sync_guarded($limit, false, $maxWrites, $userId, 'bitrix_agent');
        $config = a7_read_config();
        $config['recording_agent_last_run'] = date('c');
        $config['recording_agent_last_error'] = '';
        $config['recording_agent_last_result'] = [
            'checkedRecordings' => $result['checkedRecordings'] ?? 0,
            'matchedCount' => $result['matchedCount'] ?? 0,
            'createdCount' => $result['createdCount'] ?? 0,
            'skippedCount' => $result['skippedCount'] ?? 0,
            'failedCount' => $result['failedCount'] ?? 0,
        ];
        a7_write_config($config);
    } catch (Throwable $e) {
        $config['recording_agent_last_run'] = date('c');
        $config['recording_agent_last_error'] = $e->getMessage();
        a7_write_config($config);
        a7_log('recording sync agent exception', ['error' => $e->getMessage()]);
    }

    // Bitrix agents keep running only when the executed expression returns
    // the next expression. This response body becomes that next expression.
    a7_text_response($expression);
}

