function a7_find_bitrix_owner_data_matches_by_phone_filter(string $phoneDigits): array
{
    $variants = a7_phone_variants($phoneDigits);
    if (empty($variants)) {
        return ['itemIds' => [], 'items' => [], 'matchedBy' => []];
    }

    $numericFields = [
        'ufCrm5_1768317611513' => true,
        'ufCrm5_1768317656051' => true,
        'ufCrm5_1769416533028' => true,
    ];
    $numericVariants = [];
    foreach ($variants as $variant) {
        $digits = preg_replace('/\D/', '', (string)$variant) ?? '';
        $key = ltrim($digits, '0');
        if ($key !== '') {
            $numericVariants[$key] = (float)$digits;
        }
    }

    $commands = [];
    $commandMeta = [];
    $commandIndex = 0;
    foreach (a7_owner_data_phone_fields() as $field => $label) {
        $fieldFilters = isset($numericFields[$field])
            ? array_map(static function ($value) use ($field) {
                return [$field => $value];
            }, array_values($numericVariants))
            : [['@' . $field => $variants]];

        foreach ($fieldFilters as $fieldFilter) {
            $commandKey = 'owner_phone_' . $commandIndex++;
            $params = [
                'entityTypeId' => A7_OWNER_DATA_ENTITY_TYPE_ID,
                'select' => ['id', 'title', 'categoryId', 'assignedById', 'createdTime', 'updatedTime', $field],
                'filter' => array_merge(['categoryId' => A7_OWNER_DATA_CATEGORY_ID], $fieldFilter),
                'order' => ['updatedTime' => 'DESC'],
                'start' => 0,
            ];
            $commands[$commandKey] = 'crm.item.list?' . http_build_query($params);
            $commandMeta[$commandKey] = ['field' => $field, 'label' => $label];
        }
    }

    $batch = a7_bitrix_webhook_call('batch', ['halt' => 0, 'cmd' => $commands]);
    if (!$batch['ok']) {
        a7_log('Bitrix Owner Data phone batch lookup failed', [
            'status' => $batch['status'],
            'error' => $batch['error'] ?? '',
            'phone' => a7_mask_phone($phoneDigits),
        ]);
        return ['itemIds' => [], 'items' => [], 'matchedBy' => []];
    }

    $batchResults = $batch['json']['result']['result'] ?? [];
    $batchErrors = $batch['json']['result']['result_error'] ?? [];
    if (!empty($batchErrors)) {
        a7_log('Some Bitrix Owner Data phone batch commands failed', [
            'commands' => array_keys(is_array($batchErrors) ? $batchErrors : []),
        ]);
    }

    $itemMap = [];
    $fieldItemIds = [];
    foreach ($commandMeta as $commandKey => $meta) {
        $field = (string)$meta['field'];
        $label = (string)$meta['label'];
        $items = $batchResults[$commandKey]['items'] ?? [];
        if (!is_array($items)) {
            continue;
        }

        foreach ($items as $item) {
            if (!is_array($item)) {
                continue;
            }

            $itemId = (int)($item['id'] ?? 0);
            if ($itemId <= 0 || (int)($item['categoryId'] ?? 0) !== A7_OWNER_DATA_CATEGORY_ID) {
                continue;
            }

            if (!isset($itemMap[$itemId])) {
                $itemMap[$itemId] = [
                    'entityType' => 'owner_data',
                    'ownerTypeId' => A7_OWNER_DATA_ENTITY_TYPE_ID,
                    'categoryId' => A7_OWNER_DATA_CATEGORY_ID,
                    'id' => $itemId,
                    'title' => mb_substr((string)($item['title'] ?? ('Owner Data #' . $itemId)), 0, 120),
                    'assignedById' => (int)($item['assignedById'] ?? 0),
                    'createdTime' => (string)($item['createdTime'] ?? ''),
                    'updatedTime' => (string)($item['updatedTime'] ?? ''),
                    'detailUrl' => '/crm/type/' . A7_OWNER_DATA_ENTITY_TYPE_ID . '/details/' . $itemId . '/',
                    'matchedPhoneFields' => [],
                ];
            }

            $itemMap[$itemId]['matchedPhoneFields'][$field] = $label;
            $fieldItemIds[$field][$itemId] = true;
        }
    }

    $matchedBy = [];
    foreach ($fieldItemIds as $field => $ids) {
        $matchedBy[] = [
            'entityType' => 'owner_data',
            'field' => $field,
            'fieldLabel' => a7_owner_data_phone_fields()[$field] ?? $field,
            'value' => a7_mask_phone($phoneDigits),
            'count' => count($ids),
        ];
    }

    foreach ($itemMap as &$item) {
        $item['matchedPhoneFields'] = array_values($item['matchedPhoneFields']);
    }
    unset($item);

    return [
        'itemIds' => array_keys($itemMap),
        'items' => array_values($itemMap),
        'matchedBy' => $matchedBy,
    ];
}

function a7_owner_data_phone_matches(string $phoneDigits, array $item): array
{
    $keys = [];
    foreach (a7_phone_variants($phoneDigits) as $variant) {
        $digits = preg_replace('/\D/', '', (string)$variant) ?? '';
        if ($digits !== '') {
            $keys[$digits] = true;
            $withoutLeadingZero = ltrim($digits, '0');
            if ($withoutLeadingZero !== '') {
                $keys[$withoutLeadingZero] = true;
            }
        }
    }

    $matchedFields = [];
    foreach (a7_owner_data_phone_fields() as $field => $label) {
        $value = $item[$field] ?? null;
        $values = is_array($value) ? $value : [$value];
        foreach ($values as $candidate) {
            $digits = preg_replace('/\D/', '', (string)$candidate) ?? '';
            if ($digits === '') {
                continue;
            }

            if (isset($keys[$digits]) || isset($keys[ltrim($digits, '0')])) {
                $matchedFields[$field] = $label;
                break;
            }
        }
    }

    return $matchedFields;
}

function a7_owner_data_call_context(array $recording): array
{
    static $contexts = [];

    $recordingStart = strtotime((string)($recording['StartTime'] ?? ''));
    if ($recordingStart === false) {
        return ['fromTs' => 0, 'toTs' => 0, 'activities' => [], 'items' => []];
    }
    $recordingEnd = strtotime((string)($recording['EndTime'] ?? ''));
    if ($recordingEnd === false) {
        $recordingEnd = $recordingStart;
    }

    $requiredFrom = $recordingStart - A7_RECORDING_CALL_TIME_TOLERANCE_SECONDS;
    $requiredTo = $recordingEnd + A7_RECORDING_CALL_TIME_TOLERANCE_SECONDS;
    foreach ($contexts as $context) {
        if ($requiredFrom >= (int)$context['fromTs'] && $requiredTo <= (int)$context['toTs']) {
            return $context;
        }
    }

    $fromTs = $recordingStart - 3600;
    $toTs = $recordingEnd + A7_RECORDING_CALL_TIME_TOLERANCE_SECONDS;
    $activities = [];
    for ($start = 0; $start < 100; $start += 50) {
        $response = a7_bitrix_webhook_call('crm.activity.list', [
            'order' => ['ID' => 'DESC'],
            'filter' => [
                'OWNER_TYPE_ID' => A7_OWNER_DATA_ENTITY_TYPE_ID,
                'TYPE_ID' => 2,
                '>=START_TIME' => date('c', $fromTs),
                '<=START_TIME' => date('c', $toTs),
            ],
            'select' => ['ID', 'OWNER_TYPE_ID', 'OWNER_ID', 'START_TIME', 'END_TIME', 'DIRECTION', 'RESPONSIBLE_ID', 'PROVIDER_ID'],
            'start' => $start,
        ]);

        $page = $response['json']['result'] ?? [];
        if (!$response['ok'] || !is_array($page)) {
            break;
        }

        $activities = array_merge($activities, $page);
        if (count($page) < 50) {
            break;
        }
    }

    $ownerIds = [];
    foreach ($activities as $activity) {
        $ownerId = is_array($activity) ? (int)($activity['OWNER_ID'] ?? 0) : 0;
        if ($ownerId > 0) {
            $ownerIds[$ownerId] = true;
        }
    }

    $items = [];
    foreach (array_chunk(array_keys($ownerIds), 50) as $chunkIndex => $ownerIdChunk) {
        $commands = [];
        foreach ($ownerIdChunk as $ownerId) {
            $commands['owner_item_' . $ownerId] = 'crm.item.get?' . http_build_query([
                'entityTypeId' => A7_OWNER_DATA_ENTITY_TYPE_ID,
                'id' => (int)$ownerId,
            ]);
        }

        $batch = a7_bitrix_webhook_call('batch', ['halt' => 0, 'cmd' => $commands]);
        $batchResults = $batch['json']['result']['result'] ?? [];
        if (!$batch['ok'] || !is_array($batchResults)) {
            a7_log('Bitrix Owner Data call-context item batch failed', [
                'chunk' => $chunkIndex,
                'status' => $batch['status'],
                'error' => $batch['error'] ?? '',
            ]);
            continue;
        }

        foreach ($ownerIdChunk as $ownerId) {
            $item = $batchResults['owner_item_' . $ownerId]['item'] ?? null;
            if (is_array($item) && (int)($item['categoryId'] ?? 0) === A7_OWNER_DATA_CATEGORY_ID) {
                $items[(int)$ownerId] = $item;
            }
        }
    }

    $context = [
        'fromTs' => $fromTs,
        'toTs' => $toTs,
        'activities' => $activities,
        'items' => $items,
    ];
    $contexts[] = $context;
    if (count($contexts) > 3) {
        array_shift($contexts);
    }

    return $context;
}

function a7_find_bitrix_owner_data_matches(string $phoneDigits, array $recording): array
{
    $context = a7_owner_data_call_context($recording);
    $recordingStart = strtotime((string)($recording['StartTime'] ?? ''));
    if ($recordingStart === false) {
        return ['itemIds' => [], 'items' => [], 'matchedBy' => []];
    }
    $recordingEnd = strtotime((string)($recording['EndTime'] ?? ''));
    if ($recordingEnd === false) {
        $recordingEnd = $recordingStart;
    }

    $recordingDirection = a7_recording_direction((string)($recording['CallType'] ?? ''));
    $itemMap = [];
    $matchedBy = [];
    foreach ($context['activities'] as $activity) {
        if (!is_array($activity)) {
            continue;
        }

        $activityDirection = (int)($activity['DIRECTION'] ?? 0);
        if ($recordingDirection > 0 && $activityDirection > 0 && $recordingDirection !== $activityDirection) {
            continue;
        }

        $activityStart = strtotime((string)($activity['START_TIME'] ?? ''));
        if ($activityStart === false) {
            continue;
        }
        $delta = abs($activityStart - $recordingStart);
        $activityEnd = strtotime((string)($activity['END_TIME'] ?? ''));
        if ($activityEnd !== false) {
            $delta = min($delta, abs($activityEnd - $recordingEnd));
        }
        if ($delta > A7_RECORDING_CALL_TIME_TOLERANCE_SECONDS) {
            continue;
        }

        $itemId = (int)($activity['OWNER_ID'] ?? 0);
        $item = $context['items'][$itemId] ?? null;
        if (!is_array($item)) {
            continue;
        }

        $matchedFields = a7_owner_data_phone_matches($phoneDigits, $item);
        if (empty($matchedFields)) {
            continue;
        }

        if (!isset($itemMap[$itemId]) || $delta < (int)$itemMap[$itemId]['callTimeDeltaSeconds']) {
            $itemMap[$itemId] = [
                'entityType' => 'owner_data',
                'ownerTypeId' => A7_OWNER_DATA_ENTITY_TYPE_ID,
                'categoryId' => A7_OWNER_DATA_CATEGORY_ID,
                'id' => $itemId,
                'title' => mb_substr((string)($item['title'] ?? ('Owner Data #' . $itemId)), 0, 120),
                'assignedById' => (int)($item['assignedById'] ?? 0),
                'createdTime' => (string)($item['createdTime'] ?? ''),
                'updatedTime' => (string)($item['updatedTime'] ?? ''),
                'detailUrl' => '/crm/type/' . A7_OWNER_DATA_ENTITY_TYPE_ID . '/details/' . $itemId . '/',
                'matchedPhoneFields' => array_values($matchedFields),
                'callActivityId' => (int)($activity['ID'] ?? 0),
                'callTimeDeltaSeconds' => $delta,
            ];
        }
    }

    foreach ($itemMap as $item) {
        $matchedBy[] = [
            'entityType' => 'owner_data',
            'itemId' => (int)$item['id'],
            'value' => a7_mask_phone($phoneDigits),
            'fields' => $item['matchedPhoneFields'],
            'callActivityId' => (int)$item['callActivityId'],
            'callTimeDeltaSeconds' => (int)$item['callTimeDeltaSeconds'],
        ];
    }

    return [
        'itemIds' => array_keys($itemMap),
        'items' => array_values($itemMap),
        'matchedBy' => $matchedBy,
    ];
}

function a7_find_bitrix_recording_matches(string $phoneDigits, array $recording): array
{
    $leadMatch = a7_find_bitrix_lead_matches($phoneDigits);
    $ownerDataMatch = a7_find_bitrix_owner_data_matches($phoneDigits, $recording);

    return [
        'leadIds' => $leadMatch['leadIds'],
        'leads' => $leadMatch['leads'],
        'ownerDataItemIds' => $ownerDataMatch['itemIds'],
        'ownerDataItems' => $ownerDataMatch['items'],
        'entities' => array_merge($leadMatch['leads'], $ownerDataMatch['items']),
        'matchedBy' => array_merge($leadMatch['matchedBy'], $ownerDataMatch['matchedBy']),
    ];
}

function a7_recording_candidate_key(int $ownerTypeId, int $ownerId): string
{
    return $ownerTypeId . ':' . $ownerId;
}

function a7_recording_call_time_matches(array $entities, array $recording): array
{
    $recordingStart = strtotime((string)($recording['StartTime'] ?? ''));
    if ($recordingStart === false || empty($entities)) {
        return [];
    }

    $recordingEnd = strtotime((string)($recording['EndTime'] ?? ''));
    if ($recordingEnd === false) {
        $recordingEnd = $recordingStart;
    }

    $groups = [];
    $matches = [];
    foreach ($entities as $entity) {
        $ownerTypeId = (int)($entity['ownerTypeId'] ?? 0);
        $ownerId = (int)($entity['id'] ?? 0);
        if ($ownerTypeId <= 0 || $ownerId <= 0) {
            continue;
        }

        $activityId = (int)($entity['callActivityId'] ?? 0);
        $deltaSeconds = (int)($entity['callTimeDeltaSeconds'] ?? -1);
        if ($activityId > 0 && $deltaSeconds >= 0 && $deltaSeconds <= A7_RECORDING_CALL_TIME_TOLERANCE_SECONDS) {
            $matches[a7_recording_candidate_key($ownerTypeId, $ownerId)] = [
                'activityId' => $activityId,
                'deltaSeconds' => $deltaSeconds,
                'providerId' => '',
            ];
        } else {
            $groups[$ownerTypeId][$ownerId] = true;
        }
    }

    $recordingDirection = a7_recording_direction((string)($recording['CallType'] ?? ''));
    foreach ($groups as $ownerTypeId => $ownerIds) {
        $response = a7_bitrix_webhook_call('crm.activity.list', [
            'order' => ['ID' => 'DESC'],
            'filter' => [
                'OWNER_TYPE_ID' => (int)$ownerTypeId,
                '@OWNER_ID' => array_map('intval', array_keys($ownerIds)),
                'TYPE_ID' => 2,
                '>=START_TIME' => date('c', $recordingStart - A7_RECORDING_CALL_TIME_TOLERANCE_SECONDS),
                '<=START_TIME' => date('c', $recordingEnd + A7_RECORDING_CALL_TIME_TOLERANCE_SECONDS),
            ],
            'select' => ['ID', 'OWNER_TYPE_ID', 'OWNER_ID', 'START_TIME', 'END_TIME', 'DIRECTION', 'RESPONSIBLE_ID', 'PROVIDER_ID'],
            'start' => 0,
        ]);

        $activities = $response['json']['result'] ?? [];
        if (!$response['ok'] || !is_array($activities)) {
            continue;
        }

        foreach ($activities as $activity) {
            if (!is_array($activity)) {
                continue;
            }

            $activityDirection = (int)($activity['DIRECTION'] ?? 0);
            if ($recordingDirection > 0 && $activityDirection > 0 && $recordingDirection !== $activityDirection) {
                continue;
            }

            $activityStart = strtotime((string)($activity['START_TIME'] ?? ''));
            if ($activityStart === false) {
                continue;
            }

            $delta = abs($activityStart - $recordingStart);
            $activityEnd = strtotime((string)($activity['END_TIME'] ?? ''));
            if ($activityEnd !== false) {
                $delta = min($delta, abs($activityEnd - $recordingEnd));
            }
            if ($delta > A7_RECORDING_CALL_TIME_TOLERANCE_SECONDS) {
                continue;
            }

            $key = a7_recording_candidate_key((int)$ownerTypeId, (int)($activity['OWNER_ID'] ?? 0));
            if (!isset($matches[$key]) || $delta < (int)$matches[$key]['deltaSeconds']) {
                $matches[$key] = [
                    'activityId' => (int)($activity['ID'] ?? 0),
                    'deltaSeconds' => $delta,
                    'providerId' => (string)($activity['PROVIDER_ID'] ?? ''),
                ];
            }
        }
    }

    return $matches;
}

function a7_choose_best_entity_for_recording(array $entities, string $internalExtension, array $recording): ?array
{
    if (empty($entities)) {
        return null;
    }

    $internalExtension = a7_clean_extension($internalExtension);
    $extensionMatches = [];
    if ($internalExtension !== '') {
        foreach ($entities as $entity) {
            $user = a7_get_bitrix_user((int)($entity['assignedById'] ?? 0));
            if (!$user) {
                continue;
            }

            if (a7_clean_extension($user['UF_PHONE_INNER'] ?? '') === $internalExtension) {
                $extensionMatches[] = $entity;
            }
        }
    }

    if (empty($extensionMatches)) {
        if (count($entities) === 1 && (int)($entities[0]['ownerTypeId'] ?? 0) === 1) {
            $entity = $entities[0];
            $entity['selectedBecause'] = 'single_bitrix_lead_phone_match';
            return $entity;
        }
        return null;
    }

    $timeMatches = a7_recording_call_time_matches($extensionMatches, $recording);
    $ranked = [];
    foreach ($extensionMatches as $entity) {
        $key = a7_recording_candidate_key((int)$entity['ownerTypeId'], (int)$entity['id']);
        if (!isset($timeMatches[$key])) {
            continue;
        }
        $entity['callActivityId'] = (int)$timeMatches[$key]['activityId'];
        $entity['callTimeDeltaSeconds'] = (int)$timeMatches[$key]['deltaSeconds'];
        $ranked[] = $entity;
    }

    usort($ranked, static function ($a, $b) {
        return (int)$a['callTimeDeltaSeconds'] <=> (int)$b['callTimeDeltaSeconds'];
    });

    if (!empty($ranked)) {
        if (count($ranked) > 1 && (int)$ranked[0]['callTimeDeltaSeconds'] === (int)$ranked[1]['callTimeDeltaSeconds']) {
            return null;
        }
        $ranked[0]['selectedBecause'] = 'phone_owner_extension_and_call_time_match';
        return $ranked[0];
    }

    if (count($extensionMatches) === 1) {
        $entity = $extensionMatches[0];
        if ((int)($entity['ownerTypeId'] ?? 0) === A7_OWNER_DATA_ENTITY_TYPE_ID) {
            return null;
        }
        $entity['selectedBecause'] = 'unique_phone_and_owner_extension_match';
        return $entity;
    }

    return null;
}

function a7_bitrix_entity_title(string $entityType, array $entity): string
{
    $entityType = strtolower($entityType);
    if ($entityType === 'lead') {
        return mb_substr((string)($entity['TITLE'] ?? ('Lead #' . (string)($entity['ID'] ?? ''))), 0, 120);
    }

    if ($entityType === 'contact') {
        $name = trim((string)($entity['NAME'] ?? '') . ' ' . (string)($entity['LAST_NAME'] ?? ''));
        return mb_substr($name !== '' ? $name : ('Contact #' . (string)($entity['ID'] ?? '')), 0, 120);
    }

    return ucfirst($entityType) . ' #' . (string)($entity['ID'] ?? '');
}

function a7_find_bitrix_phone_matches(string $phoneDigits): array
{
    $matchedBy = [];
    $entityIdMap = [
        'lead' => [],
        'contact' => [],
    ];

    foreach (a7_phone_variants($phoneDigits) as $variant) {
        foreach ([
            'LEAD' => 'lead',
            'CONTACT' => 'contact',
        ] as $bitrixEntity => $localEntity) {
            $response = a7_bitrix_webhook_call('crm.duplicate.findbycomm', [
                'entity_type' => $bitrixEntity,
                'type' => 'PHONE',
                'values' => [$variant],
            ]);

            if (!$response['ok']) {
                a7_log('Bitrix duplicate phone lookup failed', [
                    'entity_type' => $bitrixEntity,
                    'status' => $response['status'],
                    'error' => $response['error'] ?? '',
                    'phone' => a7_mask_phone($variant),
                ]);
                continue;
            }

            $ids = $response['json']['result'][$bitrixEntity] ?? [];
            if (!is_array($ids) || empty($ids)) {
                continue;
            }

            $matchedBy[] = [
                'entityType' => $localEntity,
                'value' => a7_mask_phone($variant),
                'count' => count($ids),
            ];

            foreach ($ids as $id) {
                $id = (int)$id;
                if ($id > 0) {
                    $entityIdMap[$localEntity][$id] = true;
                }
            }
        }
    }

    $entities = [];
    foreach ($entityIdMap as $entityType => $idMap) {
        $ids = array_slice(array_keys($idMap), 0, 5);
        foreach ($ids as $entityId) {
            $prefix = a7_entity_rest_prefix($entityType);
            if ($prefix === '') {
                continue;
            }

            $response = a7_bitrix_webhook_call($prefix . '.get', ['id' => $entityId]);
            if (!$response['ok'] || !is_array($response['json']['result'] ?? null)) {
                continue;
            }

            $entity = $response['json']['result'];
            $ownerTypeId = a7_entity_type_id($entityType);
            $entities[] = [
                'entityType' => $entityType,
                'ownerTypeId' => $ownerTypeId,
                'id' => $entityId,
                'title' => a7_bitrix_entity_title($entityType, $entity),
                'assignedById' => (int)($entity['ASSIGNED_BY_ID'] ?? 0),
                'detailUrl' => '/crm/' . $entityType . '/details/' . $entityId . '/',
            ];
        }
    }

    return [
        'entities' => $entities,
        'matchedBy' => $matchedBy,
    ];
}

function a7_recording_playback_url(int $recordingId): string
{
    $url = A7_HANDLER_URL . '?action=recording&id=' . rawurlencode((string)$recordingId);
    if (!function_exists('a7_s3_recording_signature')) {
        return $url;
    }

    try {
        $signature = a7_s3_recording_signature($recordingId);
    } catch (Throwable $error) {
        // Keep legacy playback available during a guarded rollout or rollback.
        return $url;
    }

    return $url . '&sig=' . rawurlencode($signature);
}

/**
 * Resolve a missing S3 signature only after a7_require_bitrix_user() succeeds.
 * A supplied signature is never replaced, so malformed or forged values still
 * reach the strict S3 helper and produce its normal 403 response.
 */
function a7_resolve_authenticated_recording_signature(
    int $recordingId,
    string $providedSignature
): string {
    if ($providedSignature !== ''
        || $recordingId <= 0
        || !function_exists('a7_s3_recording_signature')
    ) {
        return $providedSignature;
    }

    try {
        return (string)a7_s3_recording_signature($recordingId);
    } catch (Throwable $error) {
        // Preserve the authenticated legacy 3CX fallback during rollout issues.
        return '';
    }
}

function a7_require_bitrix_admin(): int
{
    $userId = a7_require_bitrix_user();

    global $USER;
    if (!is_object($USER) || !method_exists($USER, 'IsAdmin') || !$USER->IsAdmin()) {
        a7_json(['success' => false, 'message' => 'Bitrix admin required'], 403);
    }

    return $userId;
}

function a7_recording_direction(string $callType): int
{
    if (stripos($callType, 'Inbound') !== false) {
        return 1;
    }

    if (stripos($callType, 'Outbound') !== false) {
        return 2;
    }

    return 0;
}

function a7_recording_activity_subject(int $recordingId): string
{
    return '3CX Recording #' . $recordingId;
}

function a7_recording_origin_id(int $recordingId): string
{
    return 'A7_3CX_REC_' . $recordingId;
}

function a7_format_bitrix_datetime(string $value): string
{
    $timestamp = strtotime($value);
    if ($timestamp === false) {
        return date('c');
    }

    return date('c', $timestamp);
}

function a7_recording_activity_exists(int $ownerTypeId, int $ownerId, int $recordingId): bool
{
    if ($ownerTypeId <= 0 || $ownerId <= 0 || $recordingId <= 0) {
        return false;
    }

    $originId = a7_recording_origin_id($recordingId);
    $subject = a7_recording_activity_subject($recordingId);

    foreach ([
        ['ORIGIN_ID' => $originId],
        ['SUBJECT' => $subject],
    ] as $extraFilter) {
        $response = a7_bitrix_webhook_call('crm.activity.list', [
            'order' => ['ID' => 'DESC'],
            'filter' => array_merge([
                'OWNER_TYPE_ID' => $ownerTypeId,
                'OWNER_ID' => $ownerId,
            ], $extraFilter),
            'select' => ['ID', 'SUBJECT', 'ORIGIN_ID'],
            'start' => 0,
        ]);

        if (!$response['ok']) {
            a7_log('Bitrix activity duplicate check failed', [
                'owner_type_id' => $ownerTypeId,
                'owner_id' => $ownerId,
                'recording_id' => $recordingId,
                'status' => $response['status'],
                'error' => $response['error'] ?? '',
            ]);
            continue;
        }

        $result = $response['json']['result'] ?? [];
        if (is_array($result) && !empty($result)) {
            return true;
        }
    }

    return false;
}

function a7_sync_recording_activity(array $recording, array $parties, array $selectedEntity, int $currentUserId): array
{
    $recordingId = (int)($recording['Id'] ?? 0);
    $ownerTypeId = (int)($selectedEntity['ownerTypeId'] ?? 0);
    $ownerId = (int)($selectedEntity['id'] ?? 0);
    if ($recordingId <= 0 || $ownerTypeId <= 0 || $ownerId <= 0) {
        return ['status' => 'skipped', 'reason' => 'missing_recording_or_crm_entity_id'];
    }

    if (a7_recording_activity_exists($ownerTypeId, $ownerId, $recordingId)) {
        return [
            'status' => 'skipped',
            'reason' => 'already_synced',
            'ownerTypeId' => $ownerTypeId,
            'ownerId' => $ownerId,
            'recordingId' => $recordingId,
        ];
    }

    $callType = (string)($recording['CallType'] ?? '');
    $direction = a7_recording_direction($callType);
    $startTime = a7_format_bitrix_datetime((string)($recording['StartTime'] ?? ''));
    $endTime = a7_format_bitrix_datetime((string)($recording['EndTime'] ?? ($recording['StartTime'] ?? '')));
    $internalExtension = (string)($parties['internal_extension'] ?? '');
    $phoneDigits = (string)($parties['external_phone_digits'] ?? '');
    $phoneRaw = (string)($parties['external_phone_raw'] ?? '');
    $phoneForCommunication = $phoneRaw !== '' ? $phoneRaw : ($phoneDigits !== '' ? '+' . $phoneDigits : '');
    $maskedPhone = a7_mask_phone($phoneForCommunication);
    $playbackUrl = a7_recording_playback_url($recordingId);
    $responsibleId = (int)($selectedEntity['assignedById'] ?? 0);
    if ($responsibleId <= 0) {
        $responsibleId = $currentUserId;
    }

    $description = '<p><b>3CX recording synced to Bitrix.</b></p>'
        . '<ul>'
        . '<li>Recording ID: ' . htmlspecialchars((string)$recordingId, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') . '</li>'
        . '<li>Call type: ' . htmlspecialchars($callType, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') . '</li>'
        . '<li>3CX extension: ' . htmlspecialchars($internalExtension, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') . '</li>'
        . '<li>Phone: ' . htmlspecialchars($maskedPhone, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') . '</li>'
        . '<li>Start: ' . htmlspecialchars($startTime, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') . '</li>'
        . '</ul>'
        . '<p><a href="' . htmlspecialchars($playbackUrl, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') . '" target="_blank">Play 3CX recording</a></p>';

    $fields = [
        'OWNER_TYPE_ID' => $ownerTypeId,
        'OWNER_ID' => $ownerId,
        'TYPE_ID' => 2,
        'PROVIDER_ID' => 'A7_3CX',
        'PROVIDER_TYPE_ID' => 'RECORDING',
        'ORIGIN_ID' => a7_recording_origin_id($recordingId),
        'SUBJECT' => a7_recording_activity_subject($recordingId),
        'START_TIME' => $startTime,
        'END_TIME' => $endTime,
        'COMPLETED' => 'Y',
        'RESPONSIBLE_ID' => $responsibleId,
        'DESCRIPTION' => $description,
        'DESCRIPTION_TYPE' => 3,
    ];

    if ($direction > 0) {
        $fields['DIRECTION'] = $direction;
    }

    if ($phoneForCommunication !== '' && $ownerTypeId === 1) {
        $fields['COMMUNICATIONS'] = [[
            'ENTITY_TYPE_ID' => 1,
            'ENTITY_ID' => $ownerId,
            'TYPE' => 'PHONE',
            'VALUE' => $phoneForCommunication,
        ]];
    }

    $response = a7_bitrix_webhook_call('crm.activity.add', ['fields' => $fields]);
    if (!$response['ok'] || empty($response['json']['result'])) {
        a7_log('Bitrix recording activity add failed', [
            'owner_type_id' => $ownerTypeId,
            'owner_id' => $ownerId,
            'entity_type' => (string)($selectedEntity['entityType'] ?? ''),
            'recording_id' => $recordingId,
            'status' => $response['status'],
            'error' => $response['error'] ?? '',
            'raw' => mb_substr((string)$response['raw'], 0, 300),
        ]);

        return [
            'status' => 'failed',
            'reason' => 'crm_activity_add_failed',
            'ownerTypeId' => $ownerTypeId,
            'ownerId' => $ownerId,
            'recordingId' => $recordingId,
            'bitrixStatus' => $response['status'],
        ];
    }

    return [
        'status' => 'created',
        'activityId' => (int)$response['json']['result'],
        'ownerTypeId' => $ownerTypeId,
        'ownerId' => $ownerId,
        'entityType' => (string)($selectedEntity['entityType'] ?? ''),
        'recordingId' => $recordingId,
        'responsibleId' => $responsibleId,
    ];
}

function a7_participant_external_phone(array $participant): array
{
    $knownTrunks = ['10000', '10001', '10002'];
    $candidates = [
        (string)($participant['party_caller_id'] ?? ''),
        (string)($participant['party_dn'] ?? ''),
        (string)($participant['party_caller_name'] ?? ''),
    ];

    foreach ($candidates as $candidate) {
        $digits = a7_normalize_phone_digits($candidate);
        if ($digits === '') {
            continue;
        }

        if (a7_looks_internal_extension($candidate) || in_array($digits, $knownTrunks, true)) {
            continue;
        }

        return [
            'raw' => $candidate,
            'digits' => $digits,
        ];
    }

    return ['raw' => '', 'digits' => ''];
}

function a7_live_call_direction(array $participant): int
{
    $status = strtolower((string)($participant['status'] ?? ''));
    if ($status === 'ringing') {
        return 1;
    }

    if ($status === 'dialing') {
        return 2;
    }

    return 0;
}

function a7_live_call_origin_id(string $extension, array $participant): string
{
    $callId = preg_replace('/\D/', '', (string)($participant['callid'] ?? '')) ?? '';
    $legId = preg_replace('/\D/', '', (string)($participant['legid'] ?? '')) ?? '';
    $participantId = preg_replace('/\D/', '', (string)($participant['id'] ?? '')) ?? '';

    if ($callId !== '') {
        return 'A7_3CX_LIVE_' . $extension . '_' . $callId . ($legId !== '' ? '_' . $legId : '');
    }

    return 'A7_3CX_LIVE_' . $extension . '_' . ($participantId !== '' ? $participantId : md5(json_encode($participant)));
}

function a7_live_call_activity_exists(int $ownerTypeId, int $ownerId, string $originId): bool
{
    if ($ownerTypeId <= 0 || $ownerId <= 0 || $originId === '') {
        return false;
    }

    $response = a7_bitrix_webhook_call('crm.activity.list', [
        'order' => ['ID' => 'DESC'],
        'filter' => [
            'OWNER_TYPE_ID' => $ownerTypeId,
            'OWNER_ID' => $ownerId,
            'ORIGIN_ID' => $originId,
        ],
        'select' => ['ID', 'SUBJECT', 'ORIGIN_ID'],
        'start' => 0,
    ]);

    if (!$response['ok']) {
        a7_log('Bitrix live call duplicate check failed', [
            'owner_type_id' => $ownerTypeId,
            'owner_id' => $ownerId,
            'origin_id' => $originId,
            'status' => $response['status'],
            'error' => $response['error'] ?? '',
        ]);
        return false;
    }

    $result = $response['json']['result'] ?? [];
    return is_array($result) && !empty($result);
}

function a7_choose_live_call_entity(array $entities, int $bitrixUserId): ?array
{
    if (empty($entities)) {
        return null;
    }

    foreach ($entities as $entity) {
        if ((int)($entity['assignedById'] ?? 0) === $bitrixUserId) {
            $entity['selectedBecause'] = 'assigned_to_current_bitrix_user';
            return $entity;
        }
    }

    if (count($entities) === 1) {
        $entity = $entities[0];
        $entity['selectedBecause'] = 'single_phone_match';
        return $entity;
    }

    return null;
}

function a7_sync_live_call_activity(array $participant, array $selectedEntity, string $extension, string $phoneRaw, string $phoneDigits, int $bitrixUserId): array
{
    $ownerTypeId = (int)($selectedEntity['ownerTypeId'] ?? 0);
    $ownerId = (int)($selectedEntity['id'] ?? 0);
    if ($ownerTypeId <= 0 || $ownerId <= 0) {
        return ['status' => 'skipped', 'reason' => 'missing_owner'];
    }

    $originId = a7_live_call_origin_id($extension, $participant);
    if (a7_live_call_activity_exists($ownerTypeId, $ownerId, $originId)) {
        return [
            'status' => 'skipped',
            'reason' => 'already_logged',
            'originId' => $originId,
        ];
    }

    $direction = a7_live_call_direction($participant);
    $status = (string)($participant['status'] ?? 'Unknown');
    $phoneForCommunication = $phoneRaw !== '' ? $phoneRaw : ($phoneDigits !== '' ? '+' . $phoneDigits : '');
    $maskedPhone = a7_mask_phone($phoneForCommunication);
    $subject = $direction === 2 ? '3CX outbound call detected' : '3CX incoming call detected';
    $description = '<p><b>' . htmlspecialchars($subject, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') . '</b></p>'
        . '<ul>'
        . '<li>3CX extension: ' . htmlspecialchars($extension, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') . '</li>'
        . '<li>Status: ' . htmlspecialchars($status, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') . '</li>'
        . '<li>Phone: ' . htmlspecialchars($maskedPhone, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') . '</li>'
        . '<li>Call ID: ' . htmlspecialchars((string)($participant['callid'] ?? ''), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') . '</li>'
        . '</ul>';

    $fields = [
        'OWNER_TYPE_ID' => $ownerTypeId,
        'OWNER_ID' => $ownerId,
        'TYPE_ID' => 2,
        'PROVIDER_ID' => 'A7_3CX',
        'PROVIDER_TYPE_ID' => 'LIVE_CALL',
        'ORIGIN_ID' => $originId,
        'SUBJECT' => $subject,
        'START_TIME' => date('c'),
        'END_TIME' => date('c'),
        'COMPLETED' => 'N',
        'RESPONSIBLE_ID' => $bitrixUserId,
        'DESCRIPTION' => $description,
        'DESCRIPTION_TYPE' => 3,
    ];

    if ($direction > 0) {
        $fields['DIRECTION'] = $direction;
    }

    if ($phoneForCommunication !== '') {
        $fields['COMMUNICATIONS'] = [[
            'ENTITY_TYPE_ID' => $ownerTypeId,
            'ENTITY_ID' => $ownerId,
            'TYPE' => 'PHONE',
            'VALUE' => $phoneForCommunication,
        ]];
    }

    $response = a7_bitrix_webhook_call('crm.activity.add', ['fields' => $fields]);
    if (!$response['ok'] || empty($response['json']['result'])) {
        a7_log('Bitrix live call activity add failed', [
            'owner_type_id' => $ownerTypeId,
            'owner_id' => $ownerId,
            'origin_id' => $originId,
            'status' => $response['status'],
            'error' => $response['error'] ?? '',
            'raw' => mb_substr((string)$response['raw'], 0, 300),
        ]);

        return [
            'status' => 'failed',
            'reason' => 'crm_activity_add_failed',
            'originId' => $originId,
            'bitrixStatus' => $response['status'],
        ];
    }

    return [
        'status' => 'created',
        'activityId' => (int)$response['json']['result'],
        'originId' => $originId,
    ];
}

function a7_handle_live_calls_ping(): void
{
    $bitrixUserId = a7_require_bitrix_user();
    $user = a7_get_bitrix_user($bitrixUserId);
    if (!$user) {
        a7_json(['success' => false, 'message' => 'Bitrix user not found'], 404);
    }

    $extension = a7_clean_extension($user['UF_PHONE_INNER'] ?? '');
    if ($extension === '') {
        a7_json([
            'success' => true,
            'enabled' => false,
            'reason' => 'current_user_has_no_3cx_extension',
            'calls' => [],
        ]);
    }

    $response = a7_3cx_callcontrol_get_json('/callcontrol/' . rawurlencode($extension));
    if (!$response['ok'] || !is_array($response['json'] ?? null)) {
        a7_log('3CX live calls fetch failed', [
            'extension' => $extension,
            'status' => $response['status'],
            'error' => $response['error'] ?? '',
            'raw' => mb_substr((string)$response['raw'], 0, 300),
        ]);
        a7_json(['success' => false, 'message' => 'Unable to fetch live 3CX calls'], 502);
    }

    $participants = $response['json']['participants'] ?? [];
    $calls = [];
    $createdCount = 0;
    foreach (is_array($participants) ? $participants : [] as $participant) {
        if (!is_array($participant)) {
            continue;
        }

        $phone = a7_participant_external_phone($participant);
        if ($phone['digits'] === '') {
            continue;
        }

        $match = a7_find_bitrix_phone_matches($phone['digits']);
        $selectedEntity = a7_choose_live_call_entity($match['entities'], $bitrixUserId);
        $sync = ['status' => 'skipped', 'reason' => 'no_unambiguous_match'];
        if ($selectedEntity !== null) {
            $sync = a7_sync_live_call_activity($participant, $selectedEntity, $extension, $phone['raw'], $phone['digits'], $bitrixUserId);
            if (($sync['status'] ?? '') === 'created') {
                $createdCount++;
            }
        }

        $calls[] = [
            'originId' => a7_live_call_origin_id($extension, $participant),
            'extension' => $extension,
            'status' => (string)($participant['status'] ?? ''),
            'direction' => a7_live_call_direction($participant) === 2 ? 'outbound' : 'incoming',
            'phoneMasked' => a7_mask_phone($phone['raw'] !== '' ? $phone['raw'] : $phone['digits']),
            'phoneDigitsTail' => substr($phone['digits'], -4),
            'matches' => array_map(static function ($entity) {
                return [
                    'entityType' => $entity['entityType'],
                    'id' => $entity['id'],
                    'title' => $entity['title'],
                    'detailUrl' => $entity['detailUrl'],
                ];
            }, $match['entities']),
            'selectedEntity' => $selectedEntity ? [
                'entityType' => $selectedEntity['entityType'],
                'id' => $selectedEntity['id'],
                'title' => $selectedEntity['title'],
                'detailUrl' => $selectedEntity['detailUrl'],
            ] : null,
            'sync' => $sync,
        ];
    }

    a7_json([
        'success' => true,
        'enabled' => true,
        'extension' => $extension,
        'createdCount' => $createdCount,
        'calls' => $calls,
    ]);
}

function a7_auth_from_request(): array
{
    $auth = $_POST['auth'] ?? $_GET['auth'] ?? [];
    if (is_array($auth) && !empty($auth)) {
        return $auth;
    }

    $accessToken = (string) a7_request_value('AUTH_ID', '');
    if ($accessToken === '') {
        $accessToken = (string) a7_request_value('access_token', '');
    }

    $domain = (string) a7_request_value('DOMAIN', ($_SERVER['HTTP_HOST'] ?? ''));
    $protocol = (string) a7_request_value('PROTOCOL', 'https');
    if ($protocol !== 'http' && $protocol !== 'https') {
        $protocol = 'https';
    }

    $clientEndpoint = (string) a7_request_value('client_endpoint', '');
    if ($clientEndpoint === '' && $domain !== '') {
        $clientEndpoint = $protocol . '://' . $domain . '/rest/';
    }

    return [
        'access_token' => $accessToken,
        'domain' => $domain,
        'client_endpoint' => $clientEndpoint,
        'application_token' => (string) a7_request_value('APP_SID', (string) a7_request_value('application_token', '')),
    ];
}

function a7_handle_install(): void
{
    $auth = a7_auth_from_request();
    if (empty($auth['access_token'])) {
        a7_json(['success' => false, 'message' => 'Missing Bitrix install auth'], 400);
    }

    $config = a7_read_config();
    $config['installed_at'] = date('c');
    $config['domain'] = $auth['domain'] ?? ($_SERVER['HTTP_HOST'] ?? '');
    $config['application_token'] = $auth['application_token'] ?? ($config['application_token'] ?? '');
    a7_write_config($config);

    $bind = a7_bitrix_call('event.bind', [
        'EVENT' => 'ONEXTERNALCALLSTART',
        'HANDLER' => A7_HANDLER_URL . '?action=event',
    ], $auth);

    $line = a7_bitrix_call('telephony.externalLine.add', [
        'NUMBER' => 'A7-3CX-DYNAMIC',
        'NAME' => 'A7 3CX Click-to-Call',
        'CRM_AUTO_CREATE' => 'N',
    ], $auth);

    a7_log('install complete', [
        'bind_ok' => $bind['ok'],
        'bind_status' => $bind['status'],
        'line_ok' => $line['ok'],
        'line_status' => $line['status'],
        'line_result' => $line['json']['result'] ?? null,
    ]);

    a7_json([
        'success' => true,
        'message' => 'A7 3CX Click-to-Call app installed',
        'event_bind_ok' => $bind['ok'],
        'external_line_ok' => $line['ok'],
        'external_line' => $line['json']['result'] ?? null,
    ]);
}

function a7_handle_event(): void
{
    $event = (string)($_POST['event'] ?? $_GET['event'] ?? '');
    $data = $_POST['data'] ?? $_GET['data'] ?? [];
    $auth = a7_auth_from_request();
    $config = a7_read_config();

    if ($event !== 'ONEXTERNALCALLSTART') {
        a7_json(['success' => true, 'message' => 'Ignored event', 'event' => $event]);
    }

    if (!is_array($data)) {
        $data = [];
    }

    if (!empty($config['application_token']) && !empty($auth['application_token'])) {
        if (!hash_equals((string)$config['application_token'], (string)$auth['application_token'])) {
            a7_log('invalid application token');
            a7_json(['success' => false, 'message' => 'Invalid application token'], 403);
        }
    }

    $phone = (string)($data['PHONE_NUMBER_INTERNATIONAL'] ?? $data['PHONE_NUMBER'] ?? '');
    $callId = (string)($data['CALL_ID'] ?? '');
    $userId = (int)($data['USER_ID'] ?? 0);
    $eventEntityType = a7_event_entity_type($data);
    $eventEntityId = a7_event_entity_id($data);

    if ($phone === '') {
        a7_json(['success' => false, 'message' => 'Missing phone number'], 400);
    }

    try {
        $callOwner = a7_resolve_owner_extension($eventEntityType, $eventEntityId, $userId);

        $makeCall = a7_3cx_make_call($phone, [
            'bitrix_call_id' => $callId,
            'bitrix_user_id' => $userId,
            'call_owner_user_id' => $callOwner['bitrix_user_id'],
            'call_owner_email' => $callOwner['email'],
            'entity_type' => $eventEntityType,
            'entity_id' => $eventEntityId,
            'source' => 'bitrix_native_event',
        ], $callOwner['extension']);

        if (!$makeCall['ok']) {
            a7_log('3CX makecall failed', [
                'phone' => $phone,
                'extension' => $callOwner['extension'],
                'call_owner_user_id' => $callOwner['bitrix_user_id'],
                'status' => $makeCall['status'],
                'raw' => (string)$makeCall['raw'],
            ]);
            if ($callId !== '' && $userId > 0) {
                a7_bitrix_call('telephony.externalCall.finish', [
                    'CALL_ID' => $callId,
                    'USER_ID' => $userId,
                    'DURATION' => 0,
                    'STATUS_CODE' => '603',
                    'ADD_TO_CHAT' => 1,
                ], $auth);
            }
            a7_json(['success' => false, 'message' => '3CX makecall failed'], 502);
        }

        a7_log('3CX makecall started', [
            'phone' => $phone,
            'bitrix_call_id' => $callId,
            'bitrix_user_id' => $userId,
            'extension' => $callOwner['extension'],
            'call_owner_user_id' => $callOwner['bitrix_user_id'],
            'entity_type' => $eventEntityType,
            'entity_id' => $eventEntityId,
            'threecx_status' => $makeCall['status'],
        ]);

        // Keep the Bitrix call record from hanging. A later recording-sync pass can
        // attach the actual 3CX recording to this CALL_ID when available.
        $finish = null;
        if ($callId !== '' && $userId > 0) {
            $finish = a7_bitrix_call('telephony.externalCall.finish', [
                'CALL_ID' => $callId,
                'USER_ID' => $userId,
                'DURATION' => 0,
                'STATUS_CODE' => '200',
                'ADD_TO_CHAT' => 1,
            ], $auth);
        }

        a7_json([
            'success' => true,
            'message' => '3CX call started',
            'threecx_status' => $makeCall['status'],
            'extension' => $callOwner['extension'],
            'call_owner_user_id' => $callOwner['bitrix_user_id'],
            'call_owner_name' => $callOwner['name'],
            'bitrix_finish_ok' => is_array($finish) ? $finish['ok'] : null,
        ]);
    } catch (Throwable $e) {
        a7_log('event handler exception', ['error' => $e->getMessage()]);
        a7_json(['success' => false, 'message' => $e->getMessage()], 500);
    }
}

function a7_handle_manual_call(): void
{
    $userId = a7_require_bitrix_user();
    $phone = a7_clean_phone((string) a7_request_value('phone', ''));
    $entityType = strtolower((string) a7_request_value('entityType', ''));
    $entityId = (int) a7_request_value('entityId', 0);
    $pageUrl = (string) a7_request_value('pageUrl', '');

    if ($phone === '' || strlen(preg_replace('/\D/', '', $phone) ?? '') < 6) {
        a7_json(['success' => false, 'message' => 'Valid phone number missing'], 400);
    }

    try {
        $callOwner = a7_resolve_owner_extension($entityType, $entityId, $userId);

        $makeCall = a7_3cx_make_call($phone, [
            'source' => 'bitrix_manual_click',
            'bitrix_user_id' => $userId,
            'call_owner_user_id' => $callOwner['bitrix_user_id'],
            'call_owner_email' => $callOwner['email'],
            'entity_type' => $entityType,
            'entity_id' => $entityId,
            'page_url' => $pageUrl,
        ], $callOwner['extension']);

        if (!$makeCall['ok']) {
            a7_log('manual 3CX makecall failed', [
                'phone' => $phone,
                'extension' => $callOwner['extension'],
                'call_owner_user_id' => $callOwner['bitrix_user_id'],
                'status' => $makeCall['status'],
                'raw' => (string)$makeCall['raw'],
            ]);
            a7_json(['success' => false, 'message' => '3CX makecall failed'], 502);
        }

        a7_add_call_activity($phone, $entityType, $entityId, $callOwner['bitrix_user_id'], $callOwner['extension'], $makeCall);

        a7_log('manual 3CX makecall started', [
            'phone' => $phone,
            'bitrix_user_id' => $userId,
            'call_owner_user_id' => $callOwner['bitrix_user_id'],
            'call_owner_email' => $callOwner['email'],
            'extension' => $callOwner['extension'],
            'entity_type' => $entityType,
            'entity_id' => $entityId,
            'threecx_status' => $makeCall['status'],
        ]);

        a7_json([
            'success' => true,
            'message' => '3CX call started',
            'phone' => $phone,
            'extension' => $callOwner['extension'],
            'call_owner_user_id' => $callOwner['bitrix_user_id'],
            'call_owner_name' => $callOwner['name'],
        ]);
    } catch (Throwable $e) {
        a7_log('manual handler exception', ['error' => $e->getMessage()]);
        a7_json(['success' => false, 'message' => $e->getMessage()], 500);
    }
}

function a7_run_recording_sync(int $limit, bool $dryRun, int $maxWrites, int $userId, string $source = 'manual'): array
{
    if ($limit <= 0) {
        $limit = 10;
    }
    if ($limit > A7_RECORDING_MAX_LIMIT_PER_RUN) {
        $limit = A7_RECORDING_MAX_LIMIT_PER_RUN;
    }

    if ($maxWrites < 0) {
        $maxWrites = 0;
    }
    if ($maxWrites > A7_RECORDING_MAX_WRITES_PER_RUN) {
        $maxWrites = A7_RECORDING_MAX_WRITES_PER_RUN;
    }

    $path = '/xapi/v1/Recordings?$orderby=StartTime%20desc&$top=' . $limit;
    $response = a7_3cx_xapi_get_json($path);
    if (!$response['ok'] || !is_array($response['json']['value'] ?? null)) {
        a7_log('3CX recordings sync fetch failed', [
            'status' => $response['status'],
            'error' => $response['error'] ?? '',
            'raw' => mb_substr((string)$response['raw'], 0, 300),
            'source' => $source,
        ]);
        throw new RuntimeException('Unable to fetch 3CX recordings');
    }

    $cacheConfig = $dryRun ? [] : a7_read_config();
    $cacheChanged = false;
    $rows = [];
    $createdCount = 0;
    $skippedCount = 0;
    $failedCount = 0;
    foreach ($response['json']['value'] as $recording) {
        if (!is_array($recording)) {
            continue;
        }

        $recordingId = (int)($recording['Id'] ?? 0);
        $cachedSync = !$dryRun ? a7_recording_cached_skip($cacheConfig, $recordingId) : null;
        if ($cachedSync !== null) {
            $rows[] = [
                'recordingId' => $recordingId,
                'callType' => (string)($recording['CallType'] ?? ''),
                'startTime' => (string)($recording['StartTime'] ?? ''),
                'endTime' => (string)($recording['EndTime'] ?? ''),
                'duration' => (string)($recording['Duration'] ?? ''),
                'internalExtension' => '',
                'externalPhone' => '',
                'hasRecordingUrl' => !empty($recording['RecordingUrl']),
                'playbackUrl' => $recordingId > 0 ? a7_recording_playback_url($recordingId) : '',
                'bitrixLeadIds' => [],
                'bitrixLeads' => [],
                'bitrixOwnerDataItemIds' => [],
                'bitrixOwnerDataItems' => [],
                'matchedBy' => [],
                'selectedLead' => null,
                'selectedEntity' => null,
                'wouldWrite' => false,
                'sync' => $cachedSync,
            ];
            $skippedCount++;
            continue;
        }

        $parties = a7_recording_parties($recording);
        $ageSeconds = a7_recording_age_seconds($recording);
        if (!$dryRun && $ageSeconds !== null && $ageSeconds < A7_RECORDING_READY_DELAY_SECONDS) {
            $rows[] = [
                'recordingId' => $recordingId,
                'callType' => (string)($recording['CallType'] ?? ''),
                'startTime' => (string)($recording['StartTime'] ?? ''),
                'endTime' => (string)($recording['EndTime'] ?? ''),
                'duration' => (string)($recording['Duration'] ?? ''),
                'internalExtension' => $parties['internal_extension'],
                'externalPhone' => a7_mask_phone($parties['external_phone_raw'] !== '' ? $parties['external_phone_raw'] : $parties['external_phone_digits']),
                'hasRecordingUrl' => !empty($recording['RecordingUrl']),
                'playbackUrl' => $recordingId > 0 ? a7_recording_playback_url($recordingId) : '',
                'bitrixLeadIds' => [],
                'bitrixLeads' => [],
                'bitrixOwnerDataItemIds' => [],
                'bitrixOwnerDataItems' => [],
                'matchedBy' => [],
                'selectedLead' => null,
                'selectedEntity' => null,
                'wouldWrite' => false,
                'sync' => [
                    'status' => 'skipped',
                    'reason' => 'recording_ready_delay',
                    'ageSeconds' => $ageSeconds,
                    'requiredAgeSeconds' => A7_RECORDING_READY_DELAY_SECONDS,
                ],
            ];
            $skippedCount++;
            continue;
        }

        $match = [
            'leadIds' => [],
            'leads' => [],
            'ownerDataItemIds' => [],
            'ownerDataItems' => [],
            'entities' => [],
            'matchedBy' => [],
        ];

        if ($parties['external_phone_digits'] !== '') {
            $match = a7_find_bitrix_recording_matches($parties['external_phone_digits'], $recording);
        }

        $selectedEntity = a7_choose_best_entity_for_recording($match['entities'], $parties['internal_extension'], $recording);
        $selectedLead = $selectedEntity && (int)($selectedEntity['ownerTypeId'] ?? 0) === 1
            ? $selectedEntity
            : null;

        $row = [
            'recordingId' => $recordingId,
            'callType' => (string)($recording['CallType'] ?? ''),
            'startTime' => (string)($recording['StartTime'] ?? ''),
            'endTime' => (string)($recording['EndTime'] ?? ''),
            'duration' => (string)($recording['Duration'] ?? ''),
            'internalExtension' => $parties['internal_extension'],
            'externalPhone' => a7_mask_phone($parties['external_phone_raw'] !== '' ? $parties['external_phone_raw'] : $parties['external_phone_digits']),
            'hasRecordingUrl' => !empty($recording['RecordingUrl']),
            'playbackUrl' => $recordingId > 0 ? a7_recording_playback_url($recordingId) : '',
            'bitrixLeadIds' => $match['leadIds'],
            'bitrixLeads' => $match['leads'],
            'bitrixOwnerDataItemIds' => $match['ownerDataItemIds'],
            'bitrixOwnerDataItems' => $match['ownerDataItems'],
            'matchedBy' => $match['matchedBy'],
            'selectedLead' => $selectedLead,
            'selectedEntity' => $selectedEntity,
            'wouldWrite' => $selectedEntity !== null,
        ];

        if (!$dryRun) {
            if ($selectedEntity === null) {
                $row['sync'] = [
                    'status' => 'skipped',
                    'reason' => !empty($match['entities'])
                        ? 'ambiguous_or_unverified_bitrix_entity_match'
                        : 'no_matching_bitrix_entity',
                ];
                $skippedCount++;
            } elseif ($createdCount >= $maxWrites) {
                $row['sync'] = ['status' => 'skipped', 'reason' => 'max_writes_reached'];
                $skippedCount++;
            } else {
                $sync = a7_sync_recording_activity($recording, $parties, $selectedEntity, $userId);
                $row['sync'] = $sync;
                if (($sync['status'] ?? '') === 'created') {
                    $createdCount++;
                } elseif (($sync['status'] ?? '') === 'failed') {
                    $failedCount++;
                } else {
                    $skippedCount++;
                }
            }

            a7_recording_cache_register($cacheConfig, $recordingId, $row['sync'] ?? []);
            $cacheChanged = true;
        }

        $rows[] = $row;
    }

    if (!$dryRun && $cacheChanged) {
        a7_write_config($cacheConfig);
    }

    $matchedCount = count(array_filter($rows, static function ($row) {
        return !empty($row['wouldWrite']);
    }));

    a7_log($dryRun ? 'recording sync dry-run completed' : 'recording sync write completed', [
        'user_id' => $userId,
        'source' => $source,
        'limit' => $limit,
        'checked' => count($rows),
        'matched' => $matchedCount,
        'dry_run' => $dryRun,
        'created' => $createdCount,
        'skipped' => $skippedCount,
        'failed' => $failedCount,
    ]);

    return [
        'success' => true,
        'dryRun' => $dryRun,
        'writeModeSupported' => true,
        'maxWrites' => $maxWrites,
        'checkedRecordings' => count($rows),
