function a7_owner_data_normalize_phone_value($raw): string
{
    if ($raw === null) {
        return '';
    }
    if (is_array($raw)) {
        foreach ($raw as $part) {
            $phone = a7_owner_data_normalize_phone_value($part);
            if ($phone !== '') {
                return $phone;
            }
        }
        return '';
    }
    $text = trim((string)$raw);
    if ($text === '' || $text === '0') {
        return '';
    }
    $digits = preg_replace('/\D/', '', $text) ?? '';
    if ($digits === '') {
        return '';
    }
    if (substr($digits, 0, 2) === '00') {
        $digits = substr($digits, 2);
    }
    // Always UAE E.164 for Owner Data dial: +971… no spaces.
    if (substr($digits, 0, 3) === '971') {
        return '+' . $digits;
    }
    if (substr($digits, 0, 1) === '0') {
        return '+971' . substr($digits, 1);
    }
    if (strlen($digits) >= 8 && strlen($digits) <= 9) {
        return '+971' . $digits;
    }
    return '+' . $digits;
}

function a7_owner_data_collect_phones(array $item): array
{
    $out = [];
    $seen = [];
    foreach (a7_owner_data_phone_fields() as $field => $label) {
        $value = $item[$field] ?? null;
        $values = is_array($value) ? $value : [$value];
        foreach ($values as $candidate) {
            $phone = a7_owner_data_normalize_phone_value($candidate);
            if ($phone === '') {
                continue;
            }
            $digits = preg_replace('/\D/', '', $phone) ?? '';
            if (strlen($digits) < 6) {
                continue;
            }
            $key = strlen($digits) > 10 ? substr($digits, -10) : $digits;
            if (isset($seen[$key])) {
                continue;
            }
            $seen[$key] = true;
            $out[] = [
                'phone' => $phone,
                'label' => $label,
                'field' => $field,
            ];
        }
    }
    return $out;
}

function a7_owner_data_get_item(int $itemId): ?array
{
    if ($itemId <= 0) {
        return null;
    }
    $response = a7_bitrix_webhook_call('crm.item.get', [
        'entityTypeId' => A7_OWNER_DATA_ENTITY_TYPE_ID,
        'id' => $itemId,
    ]);
    $item = $response['json']['result']['item'] ?? null;
    if (!$response['ok'] || !is_array($item)) {
        return null;
    }
    return $item;
}

