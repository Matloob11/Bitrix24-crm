function a7_is_direct_request(): bool
{
    $script = realpath((string)($_SERVER['SCRIPT_FILENAME'] ?? ''));
    $self = realpath(__FILE__);
    return $script !== false && $self !== false && $script === $self;
}

if (a7_is_direct_request() && !headers_sent()) {
    header('Content-Type: application/json; charset=utf-8');
}

function a7_log(string $message, array $context = []): void
{
    $safeContext = $context;
    foreach (['access_token', 'refresh_token', 'client_secret', 'application_token'] as $secretKey) {
        if (isset($safeContext[$secretKey])) {
            $safeContext[$secretKey] = '***';
        }
    }

    @file_put_contents(
        A7_LOG_FILE,
        json_encode([
            'time' => date('c'),
            'message' => $message,
            'context' => $safeContext,
        ], JSON_UNESCAPED_SLASHES) . PHP_EOL,
        FILE_APPEND
    );
}

function a7_json(array $payload, int $statusCode = 200): void
{
    while (ob_get_level() > 0) {
        ob_end_clean();
    }

    if (!headers_sent()) {
        header('Content-Type: application/json; charset=utf-8');
        http_response_code($statusCode);
    }

    echo json_encode($payload, JSON_UNESCAPED_SLASHES);
    exit;
}

