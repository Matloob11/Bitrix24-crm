function a7_clean_phone(string $phone): string
{
    $phone = trim($phone);
    $phone = preg_replace('/[^\d+]/', '', $phone) ?? '';
    if (substr_count($phone, '+') > 1) {
        $phone = preg_replace('/\+/', '', $phone) ?? $phone;
    }
    if (strpos($phone, '+') > 0) {
        $phone = str_replace('+', '', $phone);
    }
    return $phone;
}

