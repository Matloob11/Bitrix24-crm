function a7_handle_owner_data_diagnostic(): void
{
    a7_require_bitrix_admin();
    $itemId = (int)a7_request_value('id', 0);
    if ($itemId <= 0) {
        a7_json(['success' => false, 'message' => 'Owner Data item id missing'], 400);
    }

    $response = a7_bitrix_webhook_call('crm.item.get', [
        'entityTypeId' => A7_OWNER_DATA_ENTITY_TYPE_ID,
        'id' => $itemId,
    ]);
    $item = $response['json']['result']['item'] ?? null;
    if (!$response['ok'] || !is_array($item)) {
        a7_json(['success' => false, 'message' => 'Owner Data item not found'], 404);
    }

    $phoneFields = [];
    foreach (a7_owner_data_phone_fields() as $field => $label) {
        $value = $item[$field] ?? null;
        $values = is_array($value) ? $value : [$value];
        $maskedValues = [];
        foreach ($values as $candidate) {
            if ($candidate !== null && trim((string)$candidate) !== '' && trim((string)$candidate) !== '0') {
                $maskedValues[] = a7_mask_phone((string)$candidate);
            }
        }
        $phoneFields[] = [
            'field' => $field,
            'label' => $label,
            'hasValue' => !empty($maskedValues),
            'maskedValues' => $maskedValues,
        ];
    }

    $assignedById = (int)($item['assignedById'] ?? 0);
    $user = a7_get_bitrix_user($assignedById);
    $extension = $user ? a7_clean_extension($user['UF_PHONE_INNER'] ?? '') : '';
    $activityResponse = a7_bitrix_webhook_call('crm.activity.list', [
        'order' => ['ID' => 'DESC'],
        'filter' => [
            'OWNER_TYPE_ID' => A7_OWNER_DATA_ENTITY_TYPE_ID,
            'OWNER_ID' => $itemId,
            'TYPE_ID' => 2,
        ],
        'select' => ['ID', 'START_TIME', 'END_TIME', 'DIRECTION', 'RESPONSIBLE_ID', 'PROVIDER_ID'],
        'start' => 0,
    ]);
    $activities = $activityResponse['json']['result'] ?? [];
    if (!is_array($activities)) {
        $activities = [];
    }

    $hasPhone = count(array_filter($phoneFields, static function ($row) {
        return !empty($row['hasValue']);
    })) > 0;

    a7_json([
        'success' => true,
        'readOnly' => true,
        'clickToCallEnabled' => A7_CALL_FEATURES_ENABLED,
        'item' => [
            'id' => $itemId,
            'title' => (string)($item['title'] ?? ''),
            'entityTypeId' => A7_OWNER_DATA_ENTITY_TYPE_ID,
            'categoryId' => (int)($item['categoryId'] ?? 0),
            'detailUrl' => '/crm/type/' . A7_OWNER_DATA_ENTITY_TYPE_ID . '/details/' . $itemId . '/',
        ],
        'phoneFields' => $phoneFields,
        'responsible' => [
            'id' => $assignedById,
            'name' => $user ? a7_user_display_name($user) : '',
            'extension' => $extension,
            'hasExtension' => $extension !== '',
        ],
        'recentCallActivities' => array_slice($activities, 0, 10),
        'readyForNextCallMatch' => $hasPhone && $extension !== '',
        'matchingRule' => 'phone_plus_responsible_extension_plus_call_time',
        'callTimeToleranceSeconds' => A7_RECORDING_CALL_TIME_TOLERANCE_SECONDS,
    ]);
}

function a7_route_request(): void
{
