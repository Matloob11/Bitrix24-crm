function a7_get_entity_assigned_user_id(string $entityType, int $entityId): int
{
    $prefix = a7_entity_rest_prefix($entityType);
    if ($prefix === '' || $entityId <= 0) {
        return 0;
    }

    $result = a7_bitrix_webhook_call($prefix . '.get', ['id' => $entityId]);
    if (!$result['ok'] || !is_array($result['json']['result'] ?? null)) {
        a7_log('Bitrix entity owner lookup failed', [
            'entity_type' => $entityType,
            'entity_id' => $entityId,
            'status' => $result['status'],
            'error' => $result['error'] ?? '',
        ]);
        return 0;
    }

    return (int)($result['json']['result']['ASSIGNED_BY_ID'] ?? 0);
}

function a7_get_bitrix_user(int $userId): ?array
{
    static $cache = [];

    if ($userId <= 0) {
        return null;
    }

    if (array_key_exists($userId, $cache)) {
        return $cache[$userId];
    }

    $result = a7_bitrix_webhook_call('user.get', ['ID' => $userId]);
    if (!$result['ok'] || !is_array($result['json']['result'] ?? null) || empty($result['json']['result'][0])) {
        a7_log('Bitrix user lookup failed', [
            'user_id' => $userId,
            'status' => $result['status'],
            'error' => $result['error'] ?? '',
        ]);
        $cache[$userId] = null;
        return null;
    }

    $cache[$userId] = $result['json']['result'][0];
    return $cache[$userId];
}

function a7_user_display_name(array $user): string
{
    $name = trim((string)($user['NAME'] ?? '') . ' ' . (string)($user['LAST_NAME'] ?? ''));
    if ($name !== '') {
        return $name;
    }

    if (!empty($user['EMAIL'])) {
        return (string)$user['EMAIL'];
    }

    return 'Bitrix user #' . (string)($user['ID'] ?? '');
}

function a7_resolve_owner_extension(string $entityType, int $entityId, int $fallbackUserId): array
{
    $ownerUserId = a7_get_entity_assigned_user_id($entityType, $entityId);
    $source = 'entity_owner';

    if ($ownerUserId <= 0) {
        $ownerUserId = $fallbackUserId;
        $source = 'current_user_fallback';
    }

    $user = a7_get_bitrix_user($ownerUserId);
    if (!$user) {
        throw new RuntimeException('Bitrix lead owner not found');
    }

    $extension = a7_clean_extension($user['UF_PHONE_INNER'] ?? '');
    if ($extension === '') {
        $name = a7_user_display_name($user);
        throw new RuntimeException('3CX extension required for ' . $name . '. Please fill Bitrix Internal phone / UF_PHONE_INNER.');
    }

    return [
        'extension' => $extension,
        'bitrix_user_id' => (int)($user['ID'] ?? $ownerUserId),
        'email' => (string)($user['EMAIL'] ?? ''),
        'name' => a7_user_display_name($user),
        'source' => $source,
    ];
}

function a7_event_entity_type(array $data): string
{
    $raw = '';
    foreach (['CRM_ENTITY_TYPE_NAME', 'CRM_ENTITY_TYPE', 'ENTITY_TYPE_NAME', 'ENTITY_TYPE', 'OWNER_TYPE', 'OWNER_TYPE_NAME'] as $key) {
        if (!empty($data[$key])) {
            $raw = (string)$data[$key];
            break;
        }
    }

    $value = strtolower(trim($raw));
    if ($value === '') {
        return '';
    }

    if (ctype_digit($value)) {
        return [
            1 => 'lead',
            2 => 'deal',
            3 => 'contact',
            4 => 'company',
        ][(int)$value] ?? '';
    }

    $value = str_replace(['crm_', 'ccrmownertype::'], '', $value);
    switch ($value) {
        case 'lead':
        case 'leads':
            return 'lead';
        case 'deal':
        case 'deals':
            return 'deal';
        case 'contact':
        case 'contacts':
            return 'contact';
        case 'company':
        case 'companies':
            return 'company';
        default:
            return '';
    }
}

function a7_event_entity_id(array $data): int
{
    foreach (['CRM_ENTITY_ID', 'ENTITY_ID', 'OWNER_ID', 'LEAD_ID', 'DEAL_ID', 'CONTACT_ID', 'COMPANY_ID'] as $key) {
        if (!empty($data[$key])) {
            return (int)$data[$key];
        }
    }

    return 0;
}

function a7_3cx_token(string $clientId = '', string $clientSecret = ''): string
{
    $clientId = $clientId !== '' ? $clientId : A7_3CX_CLIENT_ID;
    $clientSecret = $clientSecret !== '' ? $clientSecret : A7_3CX_CLIENT_SECRET;

    $body = http_build_query([
        'grant_type' => 'client_credentials',
        'client_id' => $clientId,
        'client_secret' => $clientSecret,
    ]);

    $response = a7_http_json(
        'POST',
        rtrim(A7_3CX_BASE_URL, '/') . '/connect/token',
        ['Content-Type' => 'application/x-www-form-urlencoded'],
        $body
    );

    if (!$response['ok'] || empty($response['json']['access_token'])) {
        a7_log('3CX token failed', ['client_id' => $clientId, 'status' => $response['status'], 'error' => $response['error'], 'raw' => (string)$response['raw']]);
        throw new RuntimeException('Unable to authenticate with 3CX Call Control API');
    }

    return (string) $response['json']['access_token'];
}

function a7_3cx_makecall_token(): string
{
    $clientId = (string) A7_3CX_MAKECALL_CLIENT_ID;
    $clientSecret = (string) A7_3CX_MAKECALL_CLIENT_SECRET;

    if ($clientId === '' || strpos($clientId, '__') === 0 || $clientSecret === '' || strpos($clientSecret, '__') === 0) {
        return a7_3cx_token();
    }

    return a7_3cx_token($clientId, $clientSecret);
}

function a7_3cx_attached_data_strings(array $data): array
{
    $out = [];
    foreach ($data as $key => $value) {
        if (is_array($value) || is_object($value)) {
            $out[(string)$key] = json_encode($value, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE);
            continue;
        }

        if (is_bool($value)) {
            $out[(string)$key] = $value ? '1' : '0';
            continue;
        }

        if ($value === null) {
            $out[(string)$key] = '';
            continue;
        }

        $out[(string)$key] = (string)$value;
    }

    return $out;
}

function a7_3cx_make_call(string $destination, array $attachedData = [], string $sourceExtension = ''): array
{
    $attachedData = a7_3cx_attached_data_strings($attachedData);
    $token = a7_3cx_makecall_token();
    $base = rtrim(A7_3CX_BASE_URL, '/');
    $extensionNumber = a7_clean_extension($sourceExtension);
    if ($extensionNumber === '') {
        $extensionNumber = a7_clean_extension(A7_3CX_EXTENSION);
    }
    if ($extensionNumber === '') {
        throw new RuntimeException('3CX extension required');
    }
    $extension = rawurlencode($extensionNumber);
    $headers = [
        'Authorization' => 'Bearer ' . $token,
        'Content-Type' => 'application/json',
    ];

    $devices = a7_http_json('GET', $base . '/callcontrol/' . $extension . '/devices', [
        'Authorization' => 'Bearer ' . $token,
    ]);

    $payload = [
        'destination' => $destination,
        'timeout' => 30,
        'timeoutSec' => 30,
        'attachedData1' => $attachedData,
        'attacheddata' => $attachedData,
    ];

    if ($devices['ok'] && is_array($devices['json']) && !empty($devices['json'][0]['device_id'])) {
        $deviceId = rawurlencode((string) $devices['json'][0]['device_id']);
        $deviceResponse = a7_http_json(
            'POST',
            $base . '/callcontrol/' . $extension . '/devices/' . $deviceId . '/makecall',
            $headers,
            $payload
        );

        if ($deviceResponse['ok']) {
            return $deviceResponse;
        }

        a7_log('3CX device makecall failed, falling back to DN makecall', [
            'extension' => $extensionNumber,
            'status' => $deviceResponse['status'],
            'raw' => (string)$deviceResponse['raw'],
        ]);
    }

    return a7_http_json(
        'POST',
        $base . '/callcontrol/' . $extension . '/makecall',
        $headers,
        $payload
    );
}

