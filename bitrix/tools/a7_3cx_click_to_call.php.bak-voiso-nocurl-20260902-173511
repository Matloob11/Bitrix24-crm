function a7_handle_recording_agent_ping(): void
{
    $userId = a7_require_bitrix_user();
    $config = a7_read_config();
    if (($config['recording_agent_enabled'] ?? 'Y') !== 'Y') {
        a7_json(['success' => true, 'ran' => false, 'reason' => 'disabled']);
    }

    $interval = (int)($config['recording_agent_interval'] ?? A7_RECORDING_MIN_SYNC_SECONDS);
    if ($interval < A7_RECORDING_MIN_SYNC_SECONDS) {
        $interval = A7_RECORDING_MIN_SYNC_SECONDS;
    }

    $lastRun = (string)($config['recording_agent_last_run'] ?? '');
    $lastTs = $lastRun !== '' ? strtotime($lastRun) : false;
    $minGap = max(60, $interval - 15);
    if ($lastTs !== false && (time() - $lastTs) < $minGap) {
        a7_json([
            'success' => true,
            'ran' => false,
            'reason' => 'throttled',
            'lastRun' => $lastRun,
            'nextAllowedInSeconds' => $minGap - (time() - $lastTs),
        ]);
    }

    $returnedExpression = a7_3cx_recording_sync_agent();
    $after = a7_read_config();
    $after['recording_agent_last_ping_user_id'] = $userId;
    $after['recording_agent_last_ping_at'] = date('c');
    a7_write_config($after);

    a7_json([
        'success' => true,
        'ran' => true,
        'returnedExpressionMatches' => $returnedExpression === a7_recording_agent_include_expression(),
        'lastRun' => (string)($after['recording_agent_last_run'] ?? ''),
        'lastError' => (string)($after['recording_agent_last_error'] ?? ''),
        'lastResult' => $after['recording_agent_last_result'] ?? null,
    ]);
}

function a7_send_recording_audio_response(string $raw, string $contentType, int $recordingId): void
{
    $size = strlen($raw);
    $start = 0;
    $end = $size > 0 ? $size - 1 : 0;
    $statusCode = 200;

    $range = (string)($_SERVER['HTTP_RANGE'] ?? '');
    if ($range !== '' && preg_match('/bytes=(\d*)-(\d*)/', $range, $matches)) {
        $rangeStart = (string)($matches[1] ?? '');
        $rangeEnd = (string)($matches[2] ?? '');

        if ($rangeStart === '' && $rangeEnd !== '') {
            $suffixLength = (int)$rangeEnd;
            if ($suffixLength > 0) {
                $start = max(0, $size - $suffixLength);
            }
        } elseif ($rangeStart !== '') {
            $start = (int)$rangeStart;
            if ($rangeEnd !== '') {
                $end = min($end, (int)$rangeEnd);
            }
        }

        if ($size <= 0 || $start < 0 || $start >= $size || $end < $start) {
            if (!headers_sent()) {
                http_response_code(416);
                header('Content-Range: bytes */' . $size);
                header('Accept-Ranges: bytes');
            }
            exit;
        }

        $statusCode = 206;
    }

    $length = $end - $start + 1;
    $body = $statusCode === 206 ? substr($raw, $start, $length) : $raw;

    while (ob_get_level() > 0) {
        ob_end_clean();
    }

    if (!headers_sent()) {
        http_response_code($statusCode);
        header('Content-Type: ' . ($contentType ?: 'audio/x-wav'));
        header('Content-Disposition: inline; filename="3cx-recording-' . $recordingId . '.wav"');
        header('Content-Length: ' . strlen($body));
        header('Accept-Ranges: bytes');
        header('Cache-Control: private, max-age=300');
        header('X-Content-Type-Options: nosniff');
        if ($statusCode === 206) {
            header('Content-Range: bytes ' . $start . '-' . $end . '/' . $size);
        }
    }

    echo $body;
    exit;
}

function a7_handle_recording_download(): void
{
    a7_require_bitrix_user();
    $recordingId = (int) a7_request_value('id', 0);
    if ($recordingId <= 0) {
        a7_json(['success' => false, 'message' => 'Recording id missing'], 400);
    }

    if (function_exists('a7_s3_try_redirect_recording')) {
        $providedSignature = a7_request_value('sig', '');
        if (!is_string($providedSignature)) {
            $providedSignature = 'invalid-request-type';
        }

        $signature = a7_resolve_authenticated_recording_signature(
            $recordingId,
            $providedSignature
        );
        if (a7_s3_try_redirect_recording($recordingId, $signature)) {
            exit;
        }
    }

    try {
        $token = a7_3cx_token();
        $url = rtrim(A7_3CX_BASE_URL, '/') . '/xapi/v1/Recordings/Pbx.DownloadRecording(recId=' . rawurlencode((string)$recordingId) . ')';
        $response = a7_http_raw('GET', $url, [
            'Authorization' => 'Bearer ' . $token,
            'Accept' => 'audio/*, application/octet-stream',
        ]);

        if (!$response['ok'] || $response['raw'] === '') {
            a7_log('3CX recording download failed', [
                'recording_id' => $recordingId,
                'status' => $response['status'],
                'error' => $response['error'] ?? '',
            ]);
            a7_json([
                'success' => false,
                'message' => 'Unable to download 3CX recording',
                'threecx_status' => $response['status'],
            ], 502);
        }

        a7_send_recording_audio_response($response['raw'], (string)($response['content_type'] ?? ''), $recordingId);
    } catch (Throwable $e) {
        a7_log('recording download exception', ['recording_id' => $recordingId, 'error' => $e->getMessage()]);
        a7_json(['success' => false, 'message' => $e->getMessage()], 500);
    }
}



