    if ($action === 'install' || isset($_REQUEST['install'])) {
        if (!A7_CALL_FEATURES_ENABLED) {
            a7_handle_call_feature_disabled('install');
        }
        a7_handle_install();
    }

    if ($action === 'event' || (string)($_REQUEST['event'] ?? '') === 'ONEXTERNALCALLSTART') {
        if (!A7_CALL_FEATURES_ENABLED) {
            a7_handle_call_feature_disabled('external_call_event');
        }
        a7_handle_event();
    }

    if ($action === 'manual') {
        if (!A7_CALL_FEATURES_ENABLED) {
            a7_handle_call_feature_disabled('manual_click_to_call');
        }
        a7_handle_manual_call();
    }

    if ($action === 'recording-sync') {
        a7_handle_recording_sync();
    }

    if ($action === 'recording-sync-agent') {
        a7_handle_recording_sync_agent_run();
    }

    if ($action === 'recording-agent-install') {
        a7_handle_recording_agent_install();
